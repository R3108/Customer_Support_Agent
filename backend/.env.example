# Copy to backend/.env and adjust.

# --- LLM --------------------------------------------------------------
# auto = Anthropic if ANTHROPIC_API_KEY is set, else OpenAI if OPENAI_API_KEY is set,
# else the deterministic offline engine (no key needed).
RELAY_LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
RELAY_ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
RELAY_OPENAI_MODEL=gpt-4o-mini
# Circuit breaker: after N consecutive provider failures, use the offline engine for the cooldown (seconds).
RELAY_LLM_CIRCUIT_FAILURE_THRESHOLD=3
RELAY_LLM_CIRCUIT_COOLDOWN_SECONDS=30
# Your model's token prices (USD per million tokens) for cost analytics. 0 = tokens counted, cost not shown.
RELAY_LLM_INPUT_COST_PER_MTOK=0
RELAY_LLM_OUTPUT_COST_PER_MTOK=0

# --- Agent behaviour --------------------------------------------------
RELAY_CONFIDENCE_THRESHOLD=0.6
RELAY_REFUND_APPROVAL_LIMIT=250
RELAY_LOW_CONFIDENCE_STREAK_LIMIT=2
RELAY_MEMORY_WINDOW=12

# --- Branding ---------------------------------------------------------
RELAY_COMPANY_NAME=Aurora Outfitters
RELAY_ASSISTANT_NAME=Relay

# --- API --------------------------------------------------------------
RELAY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional key for scripts and integrations (sent as the X-Admin-Key header). Acts as an admin.
RELAY_ADMIN_API_KEY=
RELAY_CHAT_RATE_LIMIT_PER_MINUTE=30
# Behind a reverse proxy / load balancer you control: take the client IP from X-Forwarded-For.
RELAY_TRUST_PROXY_HEADERS=false
# Send Strict-Transport-Security (only when the API is served over HTTPS).
RELAY_HSTS_ENABLED=false

# --- Observability ----------------------------------------------------
# text | json (one JSON object per line, with request_id, for log pipelines)
RELAY_LOG_FORMAT=text
# When set, GET /metrics requires "Authorization: Bearer <token>".
RELAY_METRICS_TOKEN=

# --- Webhooks -----------------------------------------------------------
RELAY_WEBHOOK_MAX_ATTEMPTS=6
RELAY_WEBHOOK_RETRY_POLL_SECONDS=10
# Allow webhook URLs on private/loopback networks (local receivers in development only).
RELAY_WEBHOOK_ALLOW_PRIVATE_NETWORKS=false

# --- Privacy ------------------------------------------------------------
# Mask card numbers, SSNs, CVVs, passwords and one-time codes before storage and before the LLM.
RELAY_PII_REDACTION_ENABLED=true
# Anonymize closed conversations untouched for this many days (0 = keep forever).
RELAY_RETENTION_DAYS=0

# --- Sign in with Google -----------------------------------------------
# Setting the client ID turns on login for the console. Create an OAuth client of type "Web application"
# in Google Cloud Console → APIs & Services → Credentials, and add the API's callback
# (e.g. http://localhost:8000/api/auth/google/callback) under "Authorized redirect URIs".
# After signing in, the browser returns to the console, which must be listed in RELAY_CORS_ORIGINS.
RELAY_GOOGLE_CLIENT_ID=968712460609-eulh4otacauuujsjn382drf07is6p5h2.apps.googleusercontent.com
# Keep this secret: it's only used server-side to exchange Google's authorization code.
RELAY_GOOGLE_CLIENT_SECRET=
# Optional: override the callback URL (needed behind a proxy that changes the API's public URL).
RELAY_GOOGLE_REDIRECT_URI=
# Comma-separated. These accounts are admins; list at least yourself so you can get in the first time.
RELAY_AUTH_ADMIN_EMAILS=
# Comma-separated Google Workspace domains whose members may join as agents without an invite (optional).
RELAY_AUTH_ALLOWED_DOMAINS=
RELAY_SESSION_TTL_HOURS=168
# Console and API on different sites in production? Use secure=true and samesite=none (HTTPS required).
RELAY_SESSION_COOKIE_SECURE=false
RELAY_SESSION_COOKIE_SAMESITE=lax
